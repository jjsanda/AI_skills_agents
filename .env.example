# Copy to .env (which is git-ignored) and fill in to use agentkit in real mode.
# Without these, `agentkit run` automatically falls back to deterministic mock mode.

# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model id. Model ids change over time — see
# https://docs.claude.com for the current list. Defaults to claude-opus-4-8.
AGENTKIT_MODEL=claude-opus-4-8

# Optional: force mock mode even if a key is present (1/true/yes).
AGENTKIT_MOCK=
